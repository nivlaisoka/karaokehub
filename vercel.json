{
  "buildCommand": "cd client && npm install && npx vite build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "http://50.0.0.20:3001/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "http://50.0.0.20:3001/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
